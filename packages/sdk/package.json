{
  "name": "@agent-spend-kit/sdk",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript SDK for autonomous AI agents spending via agent-spend-kit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
