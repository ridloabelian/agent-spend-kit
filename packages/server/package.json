{
  "name": "@agent-spend-kit/server",
  "version": "0.1.0",
  "description": "Hono REST API, SQLite/Drizzle policy engine, virtual card providers, and receipt reconciliation for agent-spend-kit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11"
  }
}
