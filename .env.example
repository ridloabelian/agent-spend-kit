# Server Configuration
PORT=4310
HOST=127.0.0.1
DATABASE_PATH=./data/agent-spend.db

# Card Provider: "simulator" (default, zero external credentials) | "stripe_issuing"
CARD_PROVIDER=simulator
SIMULATOR_SECRET=ask-local-dev-simulator-secret-change-me

# Optional: Stripe Issuing Adapter (only required when CARD_PROVIDER=stripe_issuing)
STRIPE_SECRET_KEY=
STRIPE_ISSUING_CARDHOLDER_ID=
STRIPE_WEBHOOK_SECRET=

# Optional: Override API target for scripts/simulate.ts
# AGENT_SPEND_API_URL=http://127.0.0.1:4310
